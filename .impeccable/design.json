      "name": "Button primary",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Variante existente de acción en Claves API.",
      "html": "<button type=\"button\" class=\"ds-button-primary\">Generar clave</button>",
      "css": ".ds-button-primary{display:inline-flex;min-height:2.75rem;align-items:center;justify-content:center;border-radius:0.5rem;padding:0.5rem 1rem;font-size:0.875rem;line-height:1.25rem;font-weight:600;cursor:pointer;transition:background-color 150ms,border-color 150ms,color 150ms;font-family:var(--font-sans, 'Inter', system-ui, -apple-system, sans-serif);border:0;background:var(--theme-primary, #ffb020);color:var(--theme-on-primary, #241400);}.ds-button-primary:hover:not(:disabled){background:color-mix(in oklab, var(--theme-primary, #ffb020) 90%, transparent);}.ds-button-primary:focus-visible{outline:2px solid var(--theme-primary, #ffb020);outline-offset:2px;}.ds-button-primary:disabled{opacity:0.6;cursor:not-allowed;}"
    },
    {
      "name": "Button secondary",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Variante existente de acción en Claves API.",
      "html": "<button type=\"button\" class=\"ds-button-secondary\">Cancelar</button>",
      "css": ".ds-button-secondary{display:inline-flex;min-height:2.75rem;align-items:center;justify-content:center;border-radius:0.5rem;padding:0.5rem 1rem;font-size:0.875rem;line-height:1.25rem;font-weight:600;cursor:pointer;transition:background-color 150ms,border-color 150ms,color 150ms;font-family:var(--font-sans, 'Inter', system-ui, -apple-system, sans-serif);background:transparent;border:1px solid var(--theme-surface-border, #78634a);color:var(--theme-text-main, #fff5e5);}.ds-button-secondary:hover:not(:disabled){background:color-mix(in oklab, var(--theme-surface-border, #78634a) 60%, transparent);}.ds-button-secondary:focus-visible{outline:2px solid var(--theme-primary, #ffb020);outline-offset:2px;}.ds-button-secondary:disabled{opacity:0.6;cursor:not-allowed;}"
    },
    {
      "name": "Button danger",
