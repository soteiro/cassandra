{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "docs": "node ../scripts/generate-docs.js",
    "prebuild": "node ../scripts/generate-docs.js",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "build:mobile": "ng build --configuration mobile",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android",
    "mobile:sync": "ng build --configuration mobile && cap sync android",
    "mobile:run": "ng build --configuration mobile && cap run android",
    "mobile:waydroid": "pnpm run mobile:sync && (cd android && JAVA_HOME=${JAVA_HOME:-$HOME/.jdks/jbr-21.0.11} ./gradlew assembleDebug) && adb install -r android/app/build/outputs/apk/debug/app-debug.apk && adb shell am start -n com.cassandra.app/.MainActivity",
    "e2e:db": "node e2e/scripts/reset-db.mjs",
    "e2e": "pnpm run e2e:db && playwright test",
    "e2e:ui": "pnpm run e2e:db && playwright test --ui"
  },
  "private": true,
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@lucide/angular": "^1.61.0",
    "mermaid": "^12.2.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@vitest/coverage-v8": "4.1.9",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  }
}
