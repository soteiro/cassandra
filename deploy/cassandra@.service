# Cassandra por entorno: cassandra@prod (8080) y cassandra@qa (8081).
# La configuración de cada instancia está en /etc/cassandra/<entorno>.env y el binario
# activo en /opt/cassandra-<entorno>/current (lo cambia /usr/local/bin/cassandra-deploy).
[Unit]
Description=Cassandra (%i)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=cassandra
Group=cassandra
WorkingDirectory=/opt/cassandra-%i
EnvironmentFile=/etc/cassandra/%i.env
ExecStart=/opt/cassandra-%i/current/cassandra-app
Restart=always
RestartSec=5s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
